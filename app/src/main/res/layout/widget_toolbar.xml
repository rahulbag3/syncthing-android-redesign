<?xml version="1.0" encoding="utf-8"?>
<androidx.appcompat.widget.Toolbar
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/toolbar"
    android:layout_width="match_parent"
    android:layout_height="?attr/actionBarSize"
    android:minHeight="?attr/actionBarSize"
    android:background="@color/surface"
    android:elevation="0dp"
    app:titleMarginStart="8dp"
    app:titleTextColor="@color/on_surface"
    app:subtitleTextColor="@color/on_surface_variant"
    android:theme="@style/ThemeOverlay.Syncthing.Toolbar"
    android:popupTheme="@style/ThemeOverlay.AppCompat.Light" >

    <!--
        Service-state indicator.

        This used to be three overlapping radio buttons whose only visible
        part was a small coloured circle. A bare dot is ambiguous without
        its surrounding context, so the state is now a pill: a coloured dot
        paired with the state name, on the same rounded shape language as
        the bottom destination bar.

        The three views stay as radio buttons rather than plain TextViews so
        that MainActivity can keep selecting between them by ID, and the
        selection is still driven purely by visibility (they never carry a
        checked state of their own).
    -->
    <RelativeLayout
        android:id="@+id/topRel1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerVertical="true"
        android:gravity="center_vertical">

        <androidx.appcompat.widget.AppCompatRadioButton
            android:id="@+id/btnActive"
            style="@style/Widget.Syncthing.StatePill"
            android:drawableStart="@drawable/status_dot_active"
            android:text="@string/state_synced" />

        <androidx.appcompat.widget.AppCompatRadioButton
            android:id="@+id/btnStarting"
            style="@style/Widget.Syncthing.StatePill"
            android:drawableStart="@drawable/status_dot_starting"
            android:text="@string/state_starting" />

        <androidx.appcompat.widget.AppCompatRadioButton
            android:id="@+id/btnDisabled"
            style="@style/Widget.Syncthing.StatePill"
            android:drawableStart="@drawable/status_dot_stopped"
            android:text="@string/state_stopped" />

    </RelativeLayout>

    <RelativeLayout
        android:id="@+id/topRelTotalSyncProgress"
        android:layout_width="34dp"
        android:layout_height="match_parent"
        android:layout_toEndOf="@+id/topRel1"
        android:visibility="gone" >

        <ProgressBar
            android:id="@+id/pbTotalSyncComplete"
            style="?android:attr/progressBarStyleHorizontal"
            android:background="@drawable/circular_shape"
            android:ellipsize="end"
            android:indeterminate="false"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:max="100"
            android:progress="0"
            android:progressDrawable="@drawable/circular_progress_bar" />

        <TextView
            android:id="@+id/tvTotalSyncComplete"
            android:background="#00000000"
            android:color="@color/on_surface"
            android:layout_centerVertical="true"
            android:gravity="center"
            android:layout_alignStart="@id/pbTotalSyncComplete"
            android:layout_alignTop="@id/pbTotalSyncComplete"
            android:layout_alignEnd="@id/pbTotalSyncComplete"
            android:layout_alignBottom="@id/pbTotalSyncComplete"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:text="@null"
            android:textSize="11sp"
            android:textStyle="bold"
            tools:ignore="SmallSp" />
    </RelativeLayout>

</androidx.appcompat.widget.Toolbar>
