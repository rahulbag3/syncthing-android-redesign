<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/drawer_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <include layout="@layout/widget_toolbar" />

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" >

            <androidx.viewpager.widget.ViewPager
                android:id="@+id/pager"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <com.google.android.material.floatingactionbutton.FloatingActionButton
                android:id="@+id/fabExit"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentBottom="true"
                android:layout_alignParentEnd="true"
                android:layout_marginEnd="@dimen/screen_margin_horizontal"
                android:layout_marginBottom="@dimen/screen_margin_vertical"
                android:contentDescription="@string/exit"
                app:srcCompat="@drawable/ic_outline_exit_to_app_24"
                app:backgroundTint="@color/primary_container"
                app:tint="@color/on_primary_container"
                app:shapeAppearanceOverlay="@style/ShapeAppearanceOverlay.Syncthing.Fab"
                app:fabSize="mini"
                app:elevation="3dp" />

        </RelativeLayout>

        <!--
            Bottom destination bar, following the M3 Expressive navigation
            bar: a floating rounded container holding the active pill.

            The bar sits outside the scrollable content so the destination
            switcher stays reachable, and it is inset from the screen edges
            with a full corner radius so it reads as a distinct surface.

            tabRippleColor is deliberately cleared. The default ripple is
            drawn as a rectangle that clips to the TabLayout bounds, which
            does not match the rounded indicator and flashes outside the
            pill. The elastic indicator animation carries the transition.
        -->
        <FrameLayout
            android:id="@+id/navBarContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/nav_bar_margin_horizontal"
            android:layout_marginEnd="@dimen/nav_bar_margin_horizontal"
            android:layout_marginBottom="@dimen/nav_bar_margin_bottom"
            android:background="@drawable/bg_nav_bar"
            android:elevation="6dp"
            android:layout_gravity="center_horizontal">

            <com.google.android.material.tabs.TabLayout
                android:id="@+id/tabContainer"
                android:layout_width="match_parent"
                android:layout_height="@dimen/nav_bar_height"
                android:background="@null"
                android:theme="@style/ThemeOverlay.Syncthing.Toolbar"
                android:paddingStart="@dimen/tab_bar_padding_horizontal"
                android:paddingEnd="@dimen/tab_bar_padding_horizontal"
                app:tabGravity="fill"
                app:tabMode="fixed"
                app:tabIndicator="@drawable/tab_indicator"
                app:tabIndicatorColor="@color/primary_container"
                app:tabIndicatorFullWidth="false"
                app:tabIndicatorAnimationMode="elastic"
                app:tabIndicatorHeight="@dimen/tab_indicator_height"
                app:tabIndicatorGravity="center"
                app:tabRippleColor="@null"
                app:tabSelectedTextColor="@color/on_primary_container"
                app:tabTextColor="@color/on_surface_variant"
                app:tabTextAppearance="@style/TextAppearance.Syncthing.TabLabel"
                app:tabPaddingStart="@dimen/tab_label_inset"
                app:tabPaddingEnd="@dimen/tab_label_inset" />

        </FrameLayout>

    </LinearLayout>

    <FrameLayout
        android:id="@+id/drawer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:clickable="true"
        android:elevation="16dp"
        android:focusable="true" />
</androidx.drawerlayout.widget.DrawerLayout>
