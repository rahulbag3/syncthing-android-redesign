<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/drawer_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <include layout="@layout/widget_toolbar" />

        <com.google.android.material.tabs.TabLayout
            android:id="@+id/tabContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/surface"
            android:elevation="0dp"
            android:theme="@style/ThemeOverlay.Syncthing.Toolbar"
            android:paddingStart="@dimen/tab_bar_padding_horizontal"
            android:paddingEnd="@dimen/tab_bar_padding_horizontal"
            android:paddingTop="@dimen/tab_bar_padding_vertical"
            android:paddingBottom="@dimen/tab_bar_padding_vertical"
            app:tabGravity="fill"
            app:tabMode="fixed"
            app:tabIndicator="@drawable/tab_indicator"
            app:tabIndicatorColor="@color/primary_container"
            app:tabIndicatorFullWidth="false"
            app:tabIndicatorAnimationMode="elastic"
            app:tabIndicatorHeight="@dimen/tab_indicator_height"
            app:tabRippleColor="@color/primary_container"
            app:tabSelectedTextColor="@color/on_primary_container"
            app:tabTextColor="@color/on_surface_variant"
            app:tabTextAppearance="@style/TextAppearance.Syncthing.TabLabel"
            app:tabPaddingStart="@dimen/tab_label_inset"
            app:tabPaddingEnd="@dimen/tab_label_inset" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/divider" />

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent" >

            <androidx.viewpager.widget.ViewPager
                android:id="@+id/pager"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <com.google.android.material.floatingactionbutton.FloatingActionButton
                android:id="@+id/fabExit"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentBottom="true"
                android:layout_alignParentEnd="true"
                android:layout_marginEnd="@dimen/screen_margin_horizontal"
                android:layout_marginBottom="@dimen/screen_margin_horizontal"
                android:contentDescription="@string/exit"
                android:tint="@color/on_primary"
                app:srcCompat="@drawable/ic_outline_exit_to_app_24"
                app:backgroundTint="@color/primary"
                app:fabSize="mini"
                app:elevation="3dp" />

        </RelativeLayout>

    </LinearLayout>

    <FrameLayout
        android:id="@+id/drawer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:clickable="true"
        android:elevation="16dp"
        android:focusable="true" />
</androidx.drawerlayout.widget.DrawerLayout>
