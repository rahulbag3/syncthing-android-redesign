<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Widget" />
    <style name="Widget.Syncthing" />

    <!-- ============================================================
         M3 Expressive shape scale
         Official M3 tokens are 4/8/12/16/28dp plus a 50% "full"
         step. Expressive keeps that ladder but leans harder on the
         large end, and adds the full/pill step that the baseline
         leaves implicit.
         ============================================================ -->
    <eat-comment />

    <style name="ShapeAppearance.Syncthing.Corner.ExtraSmall" parent="ShapeAppearance.Material3.Corner.ExtraSmall">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">6dp</item>
    </style>

    <style name="ShapeAppearance.Syncthing.Corner.Small" parent="ShapeAppearance.Material3.Corner.Small">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">12dp</item>
    </style>

    <style name="ShapeAppearance.Syncthing.Corner.Medium" parent="ShapeAppearance.Material3.Corner.Medium">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">18dp</item>
    </style>

    <style name="ShapeAppearance.Syncthing.Corner.Large" parent="ShapeAppearance.Material3.Corner.Large">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">28dp</item>
    </style>

    <style name="ShapeAppearance.Syncthing.Corner.ExtraLarge" parent="ShapeAppearance.Material3.Corner.ExtraLarge">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">36dp</item>
    </style>

    <!-- The "full" step of the M3 token scale: 50% radius, for pills
         and chips whose ends should be completely round. -->
    <style name="ShapeAppearance.Syncthing.Corner.Full" parent="ShapeAppearance.Material3.Corner.Full">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>

    <!-- ============================================================
         M3 type scale
         Expressive bumps display/headline and leans on weight for
         emphasis rather than colour alone.
         NOTE: the dotted names (TextAppearance.Material3.Display.Large)
         are a Compose-only API. The Views library exposes the baseline
         scale as unprefixed TextAppearance.* styles, so these inherit
         from those instead.
         ============================================================ -->
    <eat-comment />

    <style name="TextAppearance.Syncthing.Display.Large" parent="TextAppearance.AppCompat.Display1">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textSize">52sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">-0.025</item>
        <item name="android:lineSpacingMultiplier">1.05</item>
    </style>

    <style name="TextAppearance.Syncthing.Headline.Medium" parent="TextAppearance.AppCompat.Headline">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textSize">28sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">-0.02</item>
        <item name="android:lineSpacingMultiplier">1.1</item>
    </style>

    <style name="TextAppearance.Syncthing.Title.Large" parent="TextAppearance.AppCompat.Title">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textSize">22sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">-0.015</item>
    </style>

    <style name="TextAppearance.Syncthing.Body.Medium" parent="TextAppearance.AppCompat.Body1">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textSize">16sp</item>
        <item name="android:letterSpacing">0.0</item>
        <item name="android:lineSpacingMultiplier">1.35</item>
    </style>

    <style name="TextAppearance.Syncthing.Label.Large" parent="TextAppearance.AppCompat.Caption">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.01</item>
    </style>

    <!-- Expressive motion lives in res/anim as PathInterpolators with an
         overshooting control point, wired to the theme's spring motion
         tokens. A style cannot hold spring physics in the Views
         library, so there is deliberately no transition style here. -->
    <eat-comment />

    <!-- ============================================================
         Widget styles
         ============================================================ -->
    <eat-comment />

    <style name="Widget.Syncthing.ListView" parent="Widget.AppCompat.ListView">
        <item name="android:paddingTop">@dimen/space_sm</item>
        <item name="android:paddingBottom">88dp</item>
        <item name="android:clipToPadding">false</item>
        <item name="android:scrollbarStyle">outsideOverlay</item>
        <item name="divider">@android:color/transparent</item>
        <item name="android:divider">@null</item>
        <item name="android:dividerHeight">@dimen/list_item_spacing</item>
        <item name="android:listSelector">@drawable/list_row_selector</item>
    </style>

    <style name="Widget.Syncthing.TextView" />

    <style name="Widget.Syncthing.TextView.Label" parent="@android:style/Widget.TextView">
        <item name="android:background">?selectableItemBackground</item>
        <item name="android:drawablePadding">@dimen/space_lg</item>
        <item name="android:gravity">start|center_vertical</item>
        <item name="android:textAppearance">@style/TextAppearance.AppCompat.Body1</item>
        <item name="android:paddingLeft">@dimen/abc_action_bar_content_inset_material</item>
        <item name="android:paddingRight">@dimen/abc_action_bar_content_inset_material</item>
    </style>

    <style name="Widget.Syncthing.TextView.Label.Details">
        <item name="android:textColor">?attr/editTextColor</item>
        <item name="android:minHeight">56dp</item>
        <item name="android:paddingTop">@dimen/space_sm</item>
        <item name="android:paddingBottom">@dimen/space_sm</item>
    </style>

    <style name="Widget.Syncthing.TextView.Label.Details.WifiSsidList">
        <item name="android:paddingLeft">@dimen/space_xs</item>
        <item name="android:minHeight">48dp</item>
    </style>

    <style name="Widget.Syncthing.TextView.Label.Details.DeviceList">
        <item name="android:paddingLeft">@dimen/space_xs</item>
        <item name="android:minHeight">48dp</item>
    </style>

    <style name="Widget.Syncthing.TextView.Label.Details.Field">
        <item name="android:background">@null</item>
    </style>

    <style name="Widget.Syncthing.DrawerArrowToggle" parent="Widget.AppCompat.DrawerArrowToggle">
        <item name="spinBars">false</item>
        <item name="color">@color/on_surface</item>
    </style>

    <!-- ============================================================
         Text appearances
         ============================================================ -->
    <eat-comment />

    <style name="TextAppearance.Syncthing.ListItemPrimary" parent="TextAppearance.AppCompat.Subhead">
        <item name="android:textColor">?android:textColorPrimary</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextAppearance.Syncthing.ListItemSecondary" parent="TextAppearance.AppCompat.Body1">
        <item name="android:textColor">@color/on_surface_variant</item>
        <item name="android:textSize">13sp</item>
    </style>

    <style name="TextAppearance.Syncthing.ListItemSmall" parent="TextAppearance.AppCompat.Caption">
        <item name="android:textSize">12sp</item>
    </style>

    <style name="Widget.Syncthing.TextView.SpinnerItem" parent="Widget.AppCompat.TextView.SpinnerItem">
        <item name="android:textSize">16sp</item>
        <item name="android:paddingTop">@dimen/space_sm</item>
        <item name="android:paddingBottom">@dimen/space_sm</item>
    </style>

    <!-- ============================================================
         SegmentedButton
         ============================================================ -->
    <style name="TextViewStyleSegmentedButtonHeader">
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.01</item>
        <item name="android:gravity">center</item>
        <item name="android:lineSpacingMultiplier">1.1</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:maxLines">3</item>
    </style>

    <!-- ============================================================
         Main tab strip labels
         tabIndicatorFullWidth="false" makes the pill hug the measured
         text width, which leaves the label flush against the pill
         edges and reads as clipped. The breathing room therefore comes
         from tabPaddingStart/End on the TabLayout, not from here:
         TextAppearance only accepts colour/size/weight/tracking, so a
         padding item here would be silently ignored.
         ============================================================ -->
    <style name="TextAppearance.Syncthing.TabLabel" parent="TextAppearance.AppCompat.Subhead">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.05</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:maxLines">1</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <style name="progressBarBlue" parent="@style/Theme.AppCompat">
        <item name="colorAccent">@color/primary</item>
    </style>
    <!-- ============================================================
         New design components
         ============================================================ -->

    <!-- Expressive FAB: a mini FAB is 40dp, so a 16dp radius reads as a
         soft rounded square rather than a circle. This is the M3
         "morphing shape" idea in static form; the fully-rounded
         circle default is the other half of the morph. -->
    <style name="ShapeAppearanceOverlay.Syncthing.Fab" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">16dp</item>
    </style>

    <!--
        Toolbar service-state pill: a coloured dot plus the state name.

        The radio button glyph itself is removed, because the dot is supplied
        as a compound drawable instead. Keeping android:button="@null" is what
        stops the old circle from being drawn underneath the new dot.
    -->
    <style name="Widget.Syncthing.StatePill" parent="Widget.AppCompat.CompoundButton.RadioButton">
        <item name="android:background">@drawable/bg_status_indicator</item>
        <item name="android:button">@null</item>
        <item name="android:focusable">false</item>
        <item name="android:clickable">false</item>
        <item name="android:visibility">gone</item>
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:drawablePadding">@dimen/space_sm</item>
        <item name="android:paddingStart">@dimen/space_md</item>
        <item name="android:paddingEnd">@dimen/space_md</item>
        <item name="android:paddingTop">@dimen/space_xs</item>
        <item name="android:paddingBottom">@dimen/space_xs</item>
        <item name="android:textColor">@color/on_surface_variant</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.04</item>
        <item name="android:maxLines">1</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <!-- Card surface used by folder/device rows -->
    <style name="Widget.Syncthing.Card" parent="">
        <item name="android:background">@drawable/bg_card</item>
    </style>

    <!-- Small uppercase label used inside rows -->
    <style name="TextAppearance.Syncthing.Overline" parent="TextAppearance.AppCompat.Caption">
        <item name="android:textSize">11sp</item>
        <item name="android:textColor">@color/on_surface_variant</item>
        <item name="android:letterSpacing">0.06</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- Pill container for the sync-state text -->
    <style name="Widget.Syncthing.StatusChip" parent="">
        <item name="android:background">@drawable/bg_status_chip</item>
        <item name="android:paddingStart">@dimen/space_sm</item>
        <item name="android:paddingEnd">@dimen/space_sm</item>
        <item name="android:paddingTop">3dp</item>
        <item name="android:paddingBottom">3dp</item>
        <item name="android:textSize">11sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
    </style>

    <!-- Tinted circular action button (open folder / open device) -->
    <style name="Widget.Syncthing.IconButton" parent="">
        <item name="android:background">@drawable/bg_icon_button</item>
        <item name="android:scaleType">centerInside</item>
        <item name="android:padding">@dimen/space_md</item>
    </style>

    <!-- Compact text button used for override / revert actions -->
    <style name="Widget.Syncthing.TextButton" parent="Widget.AppCompat.Button.Borderless">
        <item name="android:textSize">12sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:paddingStart">@dimen/space_md</item>
        <item name="android:paddingEnd">@dimen/space_md</item>
        <item name="android:paddingTop">@dimen/space_sm</item>
        <item name="android:paddingBottom">@dimen/space_sm</item>
        <item name="android:drawablePadding">@dimen/space_xs</item>
    </style>
</resources>

