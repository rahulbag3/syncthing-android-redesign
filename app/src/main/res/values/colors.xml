<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!--
      ============================================================
      Syncthing Redesign - Design tokens (light scheme)
      Brand: teal / cyan. Neutrals carry a faint green-cool tint so
      surfaces and brand colours sit together harmoniously.
      ============================================================
    -->

    <!-- Brand - primary -->
    <color name="primary">#00696B</color>
    <color name="primary_dark">#004F50</color>
    <color name="on_primary">#FFFFFF</color>
    <color name="primary_container">#9CF1F3</color>
    <color name="on_primary_container">#002020</color>

    <!-- Brand - secondary -->
    <color name="secondary">#4A6364</color>
    <color name="on_secondary">#FFFFFF</color>
    <color name="secondary_container">#CCE8E9</color>
    <color name="on_secondary_container">#051F20</color>

    <!-- Brand - tertiary -->
    <color name="tertiary">#4B607C</color>
    <color name="on_tertiary">#FFFFFF</color>
    <color name="tertiary_container">#D3E4FF</color>
    <color name="on_tertiary_container">#061C35</color>

