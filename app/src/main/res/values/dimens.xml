    <!-- Tab strip -->
    <dimen name="tab_indicator_height">36dp</dimen>
    <dimen name="tab_indicator_radius">18dp</dimen>
    <!-- Inner breathing room between a tab label and the pill edge.
         The pill hugs the measured text box, so this padding is what
         keeps a label from sitting flush against the indicator. -->
    <dimen name="tab_label_inset">18dp</dimen>
    <dimen name="tab_bar_padding_horizontal">14dp</dimen>
    <dimen name="tab_bar_padding_vertical">8dp</dimen>

    <!-- Legacy -->
    <dimen name="material_divider_inset">72dp</dimen>
