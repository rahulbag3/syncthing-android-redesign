<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- ============================================================
         Spacing scale - 4dp grid
         ============================================================ -->
    <dimen name="space_2xs">2dp</dimen>
    <dimen name="space_xs">4dp</dimen>
    <dimen name="space_sm">8dp</dimen>
    <dimen name="space_md">12dp</dimen>
    <dimen name="space_lg">16dp</dimen>
    <dimen name="space_xl">24dp</dimen>
    <dimen name="space_xxl">32dp</dimen>

    <!-- Screen padding -->
    <dimen name="screen_margin_horizontal">16dp</dimen>
    <dimen name="screen_margin_vertical">12dp</dimen>

    <!-- Cards and list rows -->
    <dimen name="card_corner_radius">28dp</dimen>
    <!-- Expressive presses cards toward the large shape step so list
         rows read as soft containers rather than flat rows. -->
    <dimen name="card_stroke_width">0dp</dimen>
    <dimen name="card_elevation">0dp</dimen>
    <dimen name="list_item_spacing">10dp</dimen>
    <dimen name="list_item_padding">16dp</dimen>
    <dimen name="list_item_icon_size">40dp</dimen>

    <!-- Progress indicators -->
    <dimen name="progress_bar_height">6dp</dimen>
    <dimen name="progress_bar_height_large">8dp</dimen>

    <!-- Tab strip -->
    <!-- Expressive nav bar pills are tall enough to hold a 24dp icon
         beside its label, so the indicator grows from 36dp to 44dp
         now that each destination carries an icon as well as text. -->
    <dimen name="tab_indicator_height">44dp</dimen>
    <dimen name="tab_indicator_radius">22dp</dimen>
    <!--
        Inner breathing room between a tab label and the pill edge, applied
        as the TabLayout's tabPaddingStart/tabPaddingEnd.

        These are what keep the selected pill off the bar's own edge. The bar
        has a 32dp corner radius, so its rounded end curves inward well
        before the bar ends; a pill that runs right up to the tab boundary
        ends up sitting on that curve and reads as clipped even though it is
        drawn completely.

        They are safe to grow because the bar uses tabGravity="fill", so each
        tab keeps an equal share of the bar and the insets come out of that
        share rather than pushing the row wider. Measured in portrait, icon
        plus label plus these insets is ~109dp against a ~126dp slot, so there
        is still headroom before the three tabs would overflow.

        Note the tab's own view_main_tab.xml carries a further 2dp of padding
        on each side; that is inside the slot, the value here is outside it.

        Because each tab is an equal share but its content is a different
        width, the pill wrapping that content does not land on the same offset
        in every slot. At 420dpi the three pills measured 110.5dp wide with
        left gaps of 12.2 / 138.7 / 265.1dp, where even spacing would be
        10.4 / 132.9 / 255.4dp. The outer two therefore sit several dp further
        out than the middle one, which is what reads as the highlight being
        misaligned from button to button.

        This value cannot grow much further. The bar is 379.4dp wide in
        portrait, so each tab slot is (379.4 - 2 x this) / 3 and the 110.5dp
        pill has to fit inside it with room to spare or the label truncates.
        At 8dp there is 10.6dp of slack; at 16dp there is only 5.3dp and
        STATUS visibly cut down to "STATU". Most of the visual gap at the ends
        therefore comes from nav_bar_corner_radius, not from here.
    -->
    <dimen name="tab_label_inset">8dp</dimen>
    <!--
        Outer inset of the TabLayout inside the rounded bar. Counts against
        the same budget as tab_label_inset: TabLayout measures the tabs from
        their content and only then clips to its own padded box, so this
        value plus the label insets all eat into the room the last tab has
        before the indicator starts getting cut off.
    -->
    <dimen name="tab_bar_padding_horizontal">8dp</dimen>
    <dimen name="tab_bar_padding_vertical">6dp</dimen>

    <!-- Bottom destination bar (M3 Expressive navigation bar) -->
    <dimen name="nav_bar_height">64dp</dimen>
    <!--
        Corner radius of the bar's own ends.

        This was 32dp, which on a 64dp-tall bar makes the container a
        complete pill: the curve reaches its maximum inward sweep exactly
        where the outermost tab pills sit. A 44dp pill is centred in the
        64dp bar, so its top edge falls 10dp below the bar's top, and at
        that height a 32dp radius has already curved 8.8dp inward from the
        bounding box. The FOLDERS and STATUS pills therefore collided with
        the bar's own curved end, which is what read as the highlight being
        clipped on those two buttons while the middle one looked fine.

        20dp keeps the container clearly rounded but pulls the curve back to
        2.7dp at the pill's top edge, so the bar's edge reads as a straight
        side next to the pill instead of swallowing its end.
    -->
    <dimen name="nav_bar_corner_radius">20dp</dimen>
    <dimen name="nav_bar_margin_horizontal">16dp</dimen>
    <dimen name="nav_bar_margin_bottom">12dp</dimen>
    <!--
        Stops the bar stretching the full width of a landscape screen.
        Without a cap it spans 2187px on a 2400px-wide display, leaving the
        three destinations huddled in the middle of a very long container.

        The value also has to be wide enough to hold the tabs. Measured in
        landscape the three tabs need ~1045px of content, and anything
        narrower makes the last tab overflow the TabLayout content box. The
        indicator is then clipped by that box and the pill's right end draws
        as a flat vertical edge instead of a rounded cap. 440dp = 1155px,
        which leaves ~67px of slack for the tabs.
    -->
    <dimen name="nav_bar_max_width">440dp</dimen>

    <!-- Legacy -->
    <dimen name="material_divider_inset">72dp</dimen>
    <dimen name="toolbar_elevation">0dp</dimen>
    <dimen name="dots_margin_bottom">20dp</dimen>
    <dimen name="welcome_title">18sp</dimen>
    <dimen name="slide_title">20sp</dimen>
    <dimen name="slide_desc">16sp</dimen>
    <dimen name="desc_padding">20dp</dimen>
    <dimen name="grant_button_padding">40dp</dimen>

</resources>
